# Required before storing AI provider credentials. Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

TRADING_DB_PATH=/data/trading.db
CORS_ORIGINS=http://localhost:5173

# Explicit administrator exceptions only, comma-separated host:port.
# localhost means the backend/container, not the browser device.
AI_LOCAL_ENDPOINT_ALLOWLIST=

# Internal clock-processing endpoint remains hidden unless testing locally.
ENABLE_INTERNAL_TEST_ROUTES=false

# Does not enable live orders. Broker submission code is absent.
ENABLE_LIVE_TRADING=false
