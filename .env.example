# Required before storing AI provider credentials. Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# Generate with: python -m backend.auth_cli hash-password
ADMIN_PASSWORD_HASH=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# false permits LAN HTTP. Set true when Cloudflare Tunnel HTTPS is active.
COOKIE_SECURE=false

# GHCR image tag: latest or preferably a full commit SHA from the package workflow.
TRADING_AGENT_TAG=latest

TRADING_DB_PATH=/data/trading.db
CORS_ORIGINS=http://localhost:5173

# Explicit administrator exceptions only, comma-separated host:port.
# localhost means the backend/container, not the browser device.
AI_LOCAL_ENDPOINT_ALLOWLIST=192.168.2.77:8000

# Internal clock-processing endpoint remains hidden unless testing locally.
ENABLE_INTERNAL_TEST_ROUTES=false

# Does not enable live orders. Broker submission code is absent.
ENABLE_LIVE_TRADING=false
